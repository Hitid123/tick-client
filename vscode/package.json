{
  "name": "gettick",
  "displayName": "TICK for Claude Code & Codex",
  "description": "One sponsored line in your editor status bar, for Claude Code and Codex. 70% of gross goes to you, paid in crypto from $5.",
  "version": "0.1.11",
  "license": "MIT",
  "publisher": "tick",
  "repository": { "type": "git", "url": "https://github.com/Hitid123/tick-client" },
  "engines": { "vscode": "^1.75.0" },
  "icon": "icon.png",
  "categories": ["Other"],
  "keywords": ["claude code", "codex", "status bar", "tick"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "tick.setUp", "title": "TICK: Set up in this editor" },
      { "command": "tick.status", "title": "TICK: Show status" },
      { "command": "tick.dashboard", "title": "TICK: Open dashboard" },
      { "command": "tick.openClick", "title": "TICK: Open the sponsored link" },
      { "command": "tick.turnOff", "title": "TICK: Turn off in this editor" }
    ],
    "configuration": {
      "title": "TICK",
      "properties": {
        "tick.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the TICK line in the status bar."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce@latest package --out ../../dist/tick.vsix"
  }
}
